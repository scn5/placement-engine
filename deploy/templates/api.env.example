# API secrets — copy to ${PLACEMENT_ROOT}/secrets/api.env (owner deploy user, mode 0600).
# docker-compose.yml already sets APP_ENV=production and DATABASE_URL.
# The API needs no Telegram or LLM settings; keep them out of this file.

# Shared key the app sends as X-API-Key. Required: the API refuses to start in
# production without one of at least 32 characters. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Only if you change HEARTBEAT_SECONDS in worker.env: set the same value here,
# because /status judges the worker's heartbeat with it.
# HEARTBEAT_SECONDS=30

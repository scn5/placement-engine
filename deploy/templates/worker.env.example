# Ingestion worker secrets — copy to ${PLACEMENT_ROOT}/secrets/worker.env
# (owner deploy user, mode 0600). docker-compose.yml already sets APP_ENV,
# DATABASE_URL and TELEGRAM_SESSION_NAME (the session file lives in
# ${PLACEMENT_ROOT}/telegram, created on the VM by scripts/login_telegram.py).
# Uncomment a line only when you give it a value: an empty number fails to parse.

# ── Telegram (https://my.telegram.org/apps) ─────────────────────────────────
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Asked for by scripts/login_telegram.py; optional afterwards.
# TELEGRAM_PHONE=

# Root feeds (broadcast channels, -100… IDs). They can also be set in the app's
# Settings screen; values there are merged with these.
# MAIN_FEED_CHANNEL_ID=
# TEST_FEED_CHANNEL_ID=

# Feeds the worker reads. First boot: TEST only, for validation and pairing.
# Switch to MAIN,TEST to start the shadow run (deploy/RUNBOOK.md).
INGEST_ENVIRONMENTS=TEST

# ── LLM (Groq, OpenAI-compatible) ───────────────────────────────────────────
# LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=medium

# ── Monitoring ──────────────────────────────────────────────────────────────
# Dead-man's-switch URL, pinged every 5 minutes while Telegram is connected.
# DEADMAN_URL=
# If you change this, set the same value in api.env.
# HEARTBEAT_SECONDS=30

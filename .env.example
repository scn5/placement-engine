# =============================================================================
# Placement Engine (.env.example)
# Configuration template for AntiTele placement drive ingestion & extraction
# =============================================================================

# ── Database Configuration ──────────────────────────────────────────────────
# Production PostgreSQL (Docker / Cloud VM):
DATABASE_URL=postgresql+asyncpg://antitele:StrongPasswordHere123!@localhost:5432/anti_tele_db
# Local SQLite fallback for development:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Application Environment: development | testing | production (anything else counts as production)
APP_ENV=development

# Shared API key the app sends as X-API-Key. Required in production (>= 32 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# ── Telegram MTProto Client (Telethon) ──────────────────────────────────────
# Obtain credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=placement_session
# Optional: Pre-authenticated Telethon session string
TELEGRAM_SESSION_STRING=
# Phone number used for initial login via scripts/login_telegram.py
TELEGRAM_PHONE=+919876543210

# ── Telegram Root Feeds & Routing ───────────────────────────────────────────
# Canonical broadcast channels monitored by the two-tier listener (must be -100… channel IDs)
MAIN_FEED_CHANNEL_ID=-1001234567890
TEST_FEED_CHANNEL_ID=-1009876543210

# ── Debouncer Ingestion Window ──────────────────────────────────────────────
# Sliding window in seconds to debounce rapid message bursts from coordinators
# Production default: 90.0 | Test suites: 0.1
DEBOUNCE_DELAY_SECONDS=90.0
# A busy chat is flushed at most this long after its first buffered message
DEBOUNCE_MAX_WAIT_SECONDS=120.0

# ── Ingestion Worker (python -m app.worker) ─────────────────────────────────
# Feeds the worker reads: TEST (default, safe for development machines) or
# MAIN,TEST (production). Run exactly ONE worker per Telegram session.
INGEST_ENVIRONMENTS=TEST
# Optional dead-man's-switch URL, pinged every 5 minutes while Telegram is connected
# DEADMAN_URL=https://hc-ping.com/your-check-uuid

# ── AI / Groq LLM Inference ─────────────────────────────────────────────────
# Groq LPU endpoint for high-speed OpenAI-compatible structured extraction
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional: low | medium | high (unset = the provider's default)
# LLM_REASONING_EFFORT=medium
